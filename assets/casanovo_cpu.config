precursor_mass_tol: 50
isotope_error_range: [0, 1]
min_peptide_len: 6
predict_batch_size: 1024
n_beams: 1
top_match: 1
accelerator: "cpu"
devices:

random_seed: 454

n_log: 1
tb_summarywriter:
save_top_k: 5
model_save_folder_path: ""
val_check_interval: 50_000

n_peaks: 150
min_mz: 50.0
max_mz: 2500.0
min_intensity: 0.01
remove_precursor_tol: 2.0
max_charge: 4

dim_model: 512
n_head: 8
dim_feedforward: 1024
n_layers: 9
dropout: 0.0
dim_intensity:
max_length: 100
warmup_iters: 100_000
cosine_schedule_period_iters: 600_000
learning_rate: 5e-4
weight_decay: 1e-5
train_label_smoothing: 0.01

train_batch_size: 32
max_epochs: 30
num_sanity_val_steps: 0
calculate_precision: false

