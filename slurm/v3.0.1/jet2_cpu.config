// Single-PXD execution on the 32-vCPU / 122-GiB CPU-only Jet2 instance.
includeConfig 'pipeline.config'

executor {
    cpus = 32
    memory = '112 GB'
}

params {
    max_parallel_pxds = 1
    aria2c_threads = 8
}

process {
    withName: fetch_pxd {
        cpus = 32
        memory = '96 GB'
    }
    withName: organism_id {
        cpus = 32
        memory = '96 GB'
        maxForks = 1
        time = '24h'
    }
    withName: search {
        cpus = 32
        memory = '96 GB'
        maxForks = 1
        time = '24h'
    }
}
