  "pride_metadata": {
    "project": {
      "accession": "PXD032354",
      "title": "EVALUATION OF RESEARCH BIOPSIES IN KIDNEY TRANSPLANTATION",
      "additionalAttributes": [],
      "projectDescription": "This study set out to investigate the optimal biopsy size required for adequate quality tissue for histological and proteome assessment while upholding patient safety which is of paramount concern.",
      "sampleProcessingProtocol": "Protein extracts were prepared in parallel from tissue biopsies by RIPA lysis buffer.  The protein concentration of each tissue extract was measured using the Pierce\u2122 BCA Protein Assay Kit (Thermo Fisher Scientific, Waltham, MA, USA) according to manufacturer guidelines and reduced, alkylated, and digested. The digested peptides were desalted and labelled with TMT 11-plex reagent. Before LC-MS/MS analysis, the TMT-labelled samples were pre-fractionated at high pH. Total 16 fractions were collected and analysed on Dianox ultimate 3000 HPLC system interfaced with a Orbitrap fusion Mass spectrometer",
      "dataProcessingProtocol": "The MS/MS spectra were processed using Proteome Discover version 2.2 and database searches were carried out against a target and decoy separated Sus scrofa (Pig) database downloaded from Uni-Prot (database version 2021 containing 119,328 protein uences).",
      "projectTags": [],
      "keywords": [
        "Kidney transplantation; punch biopsy; core needle biopsy; shotgun proteomics"
      ],
