  "pride_metadata": {
    "project": {
      "accession": "PXD036466",
      "title": "Venomics of Iranian and Cypriot Macrovipera lebetina",
      "additionalAttributes": [],
      "projectDescription": "the venom proteomes of Macrovipera lebetina lebetina from Cyprus and Macrovipera lebetina cernovi from Iran were characterized using bottom-up proteomics.",
      "sampleProcessingProtocol": "RP-HPLC separation of the crude venom proteins, SDS-PAGE of fractionated proteins, and LC-MS/MS of peptides obtained from in-gel tryptic digestion of protein bands. Moreover, we also used high-resolution shotgun proteomics to gain more reliable identifi-cation, where the whole venom proteomes were subjected directly to in-solution digestion before LC-HR-MS/MS.",
      "dataProcessingProtocol": "The proteomic raw files were searched against the UniProt protein database that was taxonomically set to the Viperidae (taxon ID # 8689) databases (downloaded on March 01, 2021) using Proteome Discoverer software suite, version 2.4 (Thermo Fisher Scientific). Two search engines, SEQUEST and MS Amanda, were used with the peptide precursor and fragment ion mass tolerance set to 10 and 0.6 ppm, respectively. The parameters were set to maxi-mum of two missed cleavage sites of trypsin digestion, minimum peptide length of 6, MS1 and MS2 tolerances of 10 ppm and 0.5 Da, respectively. The dynamic modification was set to oxidation (+15.995 Da [M]) and static modifica-tion to carbamidomethyl (+57.021 Da [C]). Percolator node was used to validate identified PSMs and filter the data with parameters of a strict Target FDR (false discovery rate) of 0.01 and a relaxed Target FDR of 0.05.",
      "projectTags": [],
      "keywords": [
        "Proteomics",
        "Venom",
        "Giant viper"
      ],
