  "pride_metadata": {
    "project": {
      "accession": "PXD054439",
      "title": "Proteomic sequencing of Giardia duodenalis-secreted extracellular vesicles",
      "additionalAttributes": [],
      "projectDescription": "The study involved the proteomic sequencing of extracellular vesicles secreted by Giardia duodenalis, statistical analysis of detected proteins, and GO analysis and enrichment KEGG analysis of proteins",
      "sampleProcessingProtocol": "G. duodenalis trophozoites in the logarithmic growth phase were chilled on ice for 20 min to facilitate detachment from the tube, followed by two washes with PBS. To stimulate EV release, 1 \u00d7 106/mL parasites were incubated in TYI-S-33 medium without serum supplemented with 1 mM CaCl2 at 37 \u25e6C for 1 h or in TYI-S-33 medium with exosome-depleted serum at 37 \u25e6C for 12 h. Subsequently, the sample underwent centrifugation at 400 g for 10 min to eliminate parasites, at 8,500 g for 60 min to remove debris, and filtration through a 0.22 \u03bcm sterilized PES membrane (Merck Millipore, USA). The supernatant was further centrifuged at 120,000 g for 1.5 h. The harvested EVs were washed twice in sterilized PBS, resuspended in 200 \u03bcL PBS. LC-MS/MS assays were carried out as previously described, with peptides analyzed using an Orbitrap-Elite mass spectrometer (Thermo Scientific, USA).",
      "dataProcessingProtocol": "The MS/MS data were searched against the Uniprot G. duodenalis WB C6 strain database using Mascot Proteome Discoverer 2.3 (Thermo Scientific, USA). The data was submitted to the Mascot server through Proteome Discoverer with the following search parameters: single isotope mass; trypsin digestion, no more than 2 missed cutting sites, 2+, 3+ and 4+ charges in the peptide; fixed modification was carbamidomethylation (C); dynamically modification was oxidation (M) and acetthyl (Protein N-term); the maximum error of the parent ion was 20 ppm; the maximum error of the fragment ion was 0.1 Da. Peptides were considered valid with a FDR of 0.01 for high confidence.",
      "projectTags": [],
      "keywords": [
        "Giardia duodenalis; extracellular vesicles; lc-msms"
      ],
