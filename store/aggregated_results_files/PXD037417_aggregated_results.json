  "pride_metadata": {
    "project": {
      "accession": "PXD037417",
      "title": "Analysis of proteome change in Nicotiana benthamiana infected with rice stripe virus",
      "additionalAttributes": [],
      "projectDescription": "To reveal the global changes of the proteome change due to RSV infection, a label-free quantitation proteomics approach was performed using leaves from RSV-infected and mock-infected N. benthamiana at 10 dpi.",
      "sampleProcessingProtocol": "Sixty N. benthamiana plants were divided into 6 groups, each group contained 10 plants. Three groups were inoculated with RSV, while the other 3 groups were mock-inoculated. The upper 3 leaves were harvested for proteome analysis. Proteins of leaves were extracted and then digested into peptides with trypsin. The peptides were then analyzed by LC-MS/MS.",
      "dataProcessingProtocol": "Maxquant search engine (v.1.5.2.8) was used for MS/MS data processing. The N. benthamiana database (https://solgenomics.net/ftp/genomes/Nicotiana_benthamiana/) and RSV encoded protein sequences concatenated with reverse decoy database was were used for MS/MS data search.",
      "projectTags": [],
