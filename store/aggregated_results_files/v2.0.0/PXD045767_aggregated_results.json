  "pride_metadata": {
    "project": {
      "accession": "PXD045767",
      "title": "Proteome dynamics during differentiation of SGBS adipocytes",
      "additionalAttributes": [],
      "projectDescription": "Here, we identified temporal dynamics in the proteome during adipocyte differentiation of the human SGBS cells, applying untargeted proteomics. Samples were taken at initiation of differentiation, at an intermediate and terminal time point.",
      "sampleProcessingProtocol": "SGBS preadipocytes were differentiated over the course of 12 days into mature and lipid laden adipocytes. Samples were taken at d0 (preadipocytes), d6 (immature adipocytes) and d12 (mature adipocytes). Label-free samples were prepared using a paramagnetic bead approach and eluted in two fractions. Fractions were analysed separately in data-dependent acquisition on a setup consisting of a Ultimate 3000 RS nano ultra-performance liquid chromatography system (Thermo Fisher Scientific, USA) coupled to a Q Exactive HF Hybrid Quadrupole Orbitrap mass spectrometer (Thermo Fisher Scientific, USA) equipped with a TriVersa NanoMate system (Advion, USA).",
      "dataProcessingProtocol": ".Raw files were processed in Proteome Discoverer 2.5 using UniprotKB entries (reference proteome, including reviewed and unreviewed proteins) of Homo sapiens (downloaded 10/2021).",
      "projectTags": [],
      "keywords": [
        "Adipogenesis",
