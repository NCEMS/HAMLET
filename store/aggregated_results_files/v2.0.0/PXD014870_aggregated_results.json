    "project": {
      "accession": "PXD014870",
      "title": "Histone Kla is regulated by cellular glycolysis",
      "additionalAttributes": [],
      "projectDescription": "We have identified a new histone modification, which is derived from glycolysis end product, lactate. By SILAC-MS/MS based quantification, and U-13C6 glucose labeling experiments, we demonstrate that histone Kla is regulated by cellular glycolysis pathway",
      "sampleProcessingProtocol": "IP using pan Kla or pan Kac antibodies were conducted either from SILAC cultured MCF-7 cells with indicated treatments, or from U-13C6 glucose labeled MCF-7 cells. Following IP, samples were deslated by ziptips and analyzed by Q-Exactive.",
      "dataProcessingProtocol": "MS/MS data were searched by Maxquant. Ratio H/L of histone Kla or histone Kac modifications were normalized by corresbonding histone protein ratio derived from Maxquant.",
      "projectTags": [],
      "keywords": [
        "Human mcf-7 cells silac"
