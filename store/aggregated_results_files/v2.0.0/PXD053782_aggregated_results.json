    "project": {
      "accession": "PXD053782",
      "title": "MAGP-1 protects liver fibrosis in experimental mouse models",
      "additionalAttributes": [],
      "projectDescription": "Matrisome members in liver ECM scaffolds from Mfap2-/- mice and their littermates were identified and quantafied using liver decellularization, followed by Label-free liquid chromatography tandem mass spectrum.",
      "sampleProcessingProtocol": "Liver tissues (~100 mg) from Mfap2-/- mice and their littermates, intoxicated by CCl4 for 8 weeks, were finely dissected into small pieces, weighed, and then transferred into pre-cooled tubes for decellularization following the method outlined by Baiocchini et al.The liver ECM scaffold underwent in-solution digestion in accordance with our previously described protocol. Peptides were determined and quantafied using Label-free liquid chromatography tandem mass spectrum (LC-MS/MS).",
      "dataProcessingProtocol": "The raw data from MS was preprocessed using the Proteome Discoverer suite (version 2.4, Thermo Fisher Scientific).",
      "projectTags": [],
