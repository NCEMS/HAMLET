    "project": {
      "accession": "PXD046055",
      "title": "Structural and functional elucidation of four putative PQS-binding proteins in Pseudomonas aeruginosa",
      "additionalAttributes": [],
      "projectDescription": "The intracellular proteome was collected for the mPAO1 wild-type strain and a defined \u0394pfpI mutant made in that same background.",
      "sampleProcessingProtocol": "50 mL cultures were grown in MOPS + glucose medium and were harvested at mid-log phase. Those cells were resuspended in PBS (supplemented with TCEP and glycerol) and then sonicated. The samples were trypsinised and tandem-mass tagged before being submitted for semi-quantitative shotgun proteomic analysis.",
      "dataProcessingProtocol": "Raw data processing was performed using Proteome Discoverer (Thermo Fisher Scientific). Raw files were submitted to a database search using Mascot against a Psueomonas aureginosa database, obtained from Uniprot.  The spectra identification was performed with the following parameters: MS accuracy, 10 ppm; MS/MS accuracy of 0.8 Da;  up to two missed cleavage sites allowed; carbamidomethylation of cysteine (as well as TMT  tagging of lysine and peptide N-terminus for TMT labelled samples) as a fixed modification; dnd oxidation of methionine and deamidated asparagine and glutamine as variable modifications. Percolator node was used for false discovery rate estimation, FDR < 1 % were accepted.",
      "projectTags": [],
      "keywords": [
        "Glyoxylase",
        "Global stress response",
        "Pseudomonas aeruginosa",
        "Glyoxylate metabolism"
